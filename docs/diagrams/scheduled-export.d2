direction: right

title: {
  label: "Scheduled Export"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

eventbridge: "EventBridge\nSchedule" {
  shape: rectangle
  style.fill: "#E3F2FD"
  style.stroke: "#1565C0"
  style.font-size: 13
}

lambda: "Lambda\nhubaccelerator\nexporter" {
  shape: rectangle
  style.fill: "#FFF3E0"
  style.stroke: "#E65100"
  style.font-size: 13
}

securityhub: "Security Hub\nget_findings" {
  shape: rectangle
  style.fill: "#F3E5F5"
  style.stroke: "#6A1B9A"
  style.font-size: 13
}

s3: "S3 Bucket\nfindings.csv" {
  shape: rectangle
  style.fill: "#E8F5E9"
  style.stroke: "#2E7D32"
  style.font-size: 13
}

eventbridge -> lambda: "cron trigger"
lambda -> securityhub: "paginated\ndownload"
lambda -> s3: "upload CSV"
