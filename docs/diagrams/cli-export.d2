direction: right

title: {
  label: "CLI Export (Unscheduled)"
  near: top-center
  shape: text
  style.font-size: 20
  style.bold: true
}

workstation: "Workstation\nhubaccelerator-export" {
  shape: rectangle
  style.fill: "#E3F2FD"
  style.stroke: "#1565C0"
  style.font-size: 13
}

securityhub: "Security Hub\nget_findings" {
  shape: rectangle
  style.fill: "#F3E5F5"
  style.stroke: "#6A1B9A"
  style.font-size: 13
}

s3: "S3 Bucket\nfindings.csv" {
  shape: rectangle
  style.fill: "#E8F5E9"
  style.stroke: "#2E7D32"
  style.font-size: 13
}

local: "Local CSV\n(--retain-local)" {
  shape: rectangle
  style.fill: "#FFF3E0"
  style.stroke: "#E65100"
  style.font-size: 13
  style.stroke-dash: 5
}

workstation -> securityhub: "paginated\ndownload"
workstation -> s3: "upload CSV"
workstation -> local: "optional\nlocal copy" {
  style.stroke-dash: 5
}
